# Set these as environment variables on the server. Never put real keys in GitHub.
# The application does not automatically load .env files.
RESEND_API_KEY=
NEWSLETTER_FROM=Sophie Eats Good Food <hello@your-verified-domain.com>
SITE_URL=https://your-blog-domain.com
# A mailing address you are comfortable including in newsletter footers.
NEWSLETTER_POSTAL_ADDRESS=
# Optional: exact IPs of trusted reverse proxies; leave empty for direct access.
# Example for a local proxy: 127.0.0.1,::1
TRUSTED_PROXY_IPS=
